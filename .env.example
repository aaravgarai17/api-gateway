# Redis (rate-limit + circuit-breaker state)
REDIS_URL=redis://cache:6379/0

# Upstream service the gateway proxies to
UPSTREAM_URL=http://upstream:9000

# Circuit breaker
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT_SECONDS=30
CB_HALF_OPEN_MAX_CALLS=1

# Default tier applied to unknown API keys
DEFAULT_TIER=free
